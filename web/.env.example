# Public URL of the Express API (browser calls for reports, map, export).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side URL of the API (can be a private Railway URL).
API_URL=http://localhost:4000
# Must match the API's INTERNAL_API_KEY. Server-side only.
INTERNAL_API_KEY=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
