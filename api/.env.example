DATABASE_URL=postgresql://postgres:password@localhost:5432/tapcheck
# Shared secret between the Next.js server and this API. Never expose it to the browser.
INTERNAL_API_KEY=
# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:3000
# Either CLOUDINARY_URL or the three CLOUDINARY_* values. Without them, photos are dropped.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: stable salt so the daily limit survives restarts.
RATE_SALT=
DAILY_LIMIT=5
PER_MINUTE_LIMIT=10
PORT=4000
