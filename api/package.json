{
  "name": "tapcheck-api",
  "version": "0.2.0",
  "private": true,
  "description": "TapCheck Express API (Railway)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "node --test --test-concurrency=1 test/",
    "create-moderator": "node scripts/create-moderator.js"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true
  }
}
